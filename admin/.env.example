# Copy to .env and fill in.

# Where the shared backend API lives.
# Local dev: localhost.
# Docker Compose on the VM: this container reaches backend by container
#   name — http://al_backend:4000
# Never a publicly reachable address either way — backend has no nginx route.
BACKEND_URL="http://localhost:4000"

# --- Admin auth (Firebase Auth — shared sjs-technology project) ------------
# NEXT_PUBLIC_* values are safe to expose (Firebase web config is not a
# secret by design); access control happens via ADMIN_ALLOWED_EMAILS below.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDBkx4KX5G6mnRnYBKN_k0FGtkPRiGzZuU"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="sjs-technology.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sjs-technology"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="sjs-technology.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="30732567404"
NEXT_PUBLIC_FIREBASE_APP_ID="1:30732567404:web:dc30ebe332593766226949"

# Allowlist for the local fast-fail check (middleware + requireAdmin) —
# lib/firebaseVerify.js reuses NEXT_PUBLIC_FIREBASE_API_KEY above for the
# REST lookup. Kept in sync with backend's own copy of this allowlist.
ADMIN_ALLOWED_EMAILS="admin@vedhanthitsolutions.com,yatheesh@vedhanthitsolutions.in"

# Separate, platform-level allowlist for /super (managing Tenant rows) —
# being a tenant admin above never implies this. Kept in sync with
# backend's own copy of this allowlist.
SUPER_ADMIN_ALLOWED_EMAILS="adilakshmi.infotech@gmail.com"
