# Reference copy of /opt/nginx-extra/conf.d/vedhanth.conf on the VM (the live
# file is not in git; keep this in sync by hand). Canonical host is
# https://www.vedhanthitsolutions.in (see lib/site.js): every other variant
# redirects to it. Needs a certificate covering BOTH the apex and the
# wildcard: /etc/letsencrypt/live/vedhanthitsolutions.in/.

# --- HTTP: everything redirects to https://www ----------------------------
server {
  listen 80;
  server_name vedhanthitsolutions.in www.vedhanthitsolutions.in;
  return 301 https://www.vedhanthitsolutions.in$request_uri;
}

# --- HTTPS, bare domain: redirect to www ----------------------------------
server {
  listen 443 ssl;
  server_name vedhanthitsolutions.in;

  ssl_certificate     /etc/letsencrypt/live/vedhanthitsolutions.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vedhanthitsolutions.in/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  return 301 https://www.vedhanthitsolutions.in$request_uri;
}

# --- HTTPS, www: the real site --------------------------------------------
server {
  listen 443 ssl;
  server_name www.vedhanthitsolutions.in;
  client_max_body_size 6M;

  ssl_certificate     /etc/letsencrypt/live/vedhanthitsolutions.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vedhanthitsolutions.in/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  location /admin {
    proxy_pass http://al_admin:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /super {
    proxy_pass http://al_admin:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /al-admin-assets/ {
    rewrite ^/al-admin-assets/(.*) /$1 break;
    proxy_pass http://al_admin:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://vedhanth_frontend:4002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  add_header X-Frame-Options        "SAMEORIGIN"                       always;
  add_header X-Content-Type-Options "nosniff"                          always;
  add_header Referrer-Policy        "strict-origin-when-cross-origin"  always;

  access_log /var/log/nginx/vedhanth.access.log;
  error_log  /var/log/nginx/vedhanth.error.log;
}
