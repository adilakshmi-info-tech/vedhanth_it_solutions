# Reference copy only — the file that actually matters lives outside git on
# the VM at /opt/nginx-extra/conf.d/vedhanth.conf (see
# Deploy_New_Website_on_WACRM_VM.md). Keep this copy in sync by hand.

# --- HTTP (use alone until DNS points at the server / cert is issued) -----
server {
  listen 80;
  server_name vedhanthitsolutions.in www.vedhanthitsolutions.in;
  client_max_body_size 2M; # generous headroom for form posts (product images now go straight to the shared upload API, not through this app)

  # /admin and /super both live in the standalone admin app (al_admin),
  # not vedhanth_web — the full original path is forwarded unchanged (no
  # rewrite), matching that app's own internal routing. al_backend is
  # deliberately NOT routed here at all — it's internal-only, reached by
  # al_admin/frontend over the Docker network, never from the public
  # internet.
  location /admin {
    proxy_pass http://al_admin:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location /super {
    proxy_pass http://al_admin:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  location / {
    proxy_pass http://vedhanth_web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  access_log /var/log/nginx/vedhanth.access.log;
  error_log  /var/log/nginx/vedhanth.error.log;
}

