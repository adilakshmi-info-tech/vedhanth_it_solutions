# Reference only (the live config is on the VM). Canonical host is www over
# https, matching lib/site.js — redirect every other variant to it so search
# engines see a single address. Add alongside vedhanth.conf.
server {
  listen 80;
  server_name vedhanthitsolutions.in www.vedhanthitsolutions.in;
  return 301 https://www.vedhanthitsolutions.in$request_uri;
}

server {
  listen 443 ssl;
  server_name vedhanthitsolutions.in;
  ssl_certificate     /etc/letsencrypt/live/vedhanthitsolutions.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vedhanthitsolutions.in/privkey.pem;
  return 301 https://www.vedhanthitsolutions.in$request_uri;
}
