# Copy to .env and fill in. Both Next.js and Prisma read this file.

# Same Postgres database the current single-app deployment uses.
DATABASE_URL="postgresql://vedhanth:CHANGE_ME@localhost:5432/vedhanth?schema=public"

# Firebase web API key (sjs-technology project) — used only to verify ID
# tokens that admin/frontend forward via Authorization: Bearer. Not a
# secret by Firebase's own design (see https://firebase.google.com/docs/projects/api-keys),
# but it's server-only here since this app has no client bundle.
FIREBASE_API_KEY="AIzaSyDBkx4KX5G6mnRnYBKN_k0FGtkPRiGzZuU"

# Allowlist of admin emails permitted to call write endpoints — same
# convention as today's single-app ADMIN_ALLOWED_EMAILS.
ADMIN_ALLOWED_EMAILS="admin@vedhanthitsolutions.com,yatheesh@vedhanthitsolutions.in"

# Separate, platform-level allowlist for managing Tenant rows (/api/tenants)
# — being a tenant admin above never implies this. Empty by default, so
# nobody has super-admin access until you explicitly add an email here.
SUPER_ADMIN_ALLOWED_EMAILS=""
