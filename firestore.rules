rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Categories & Products: anyone can read, only signed-in admin can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reviews: anyone can read APPROVED reviews and submit a new one (unapproved by default).
    // Only a signed-in admin can update (approve) or delete a review.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if request.auth != null;
    }
  }
}
