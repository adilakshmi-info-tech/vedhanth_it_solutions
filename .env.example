# Copy to .env and fill in. Both Next.js and Prisma read this file.
# When running via docker-compose.yml, this same file is also the source of
# the Postgres container's credentials (env_file: .env) — keep DATABASE_URL
# and POSTGRES_* in sync with each other.

# --- Postgres container (docker-compose.yml only) --------------------------
POSTGRES_DB="vedhanth"
POSTGRES_USER="vedhanth"
POSTGRES_PASSWORD="CHANGE_ME"

# --- App -------------------------------------------------------------------
# Bare-metal / PM2: DB runs on localhost.
# Docker Compose: the web container reaches Postgres by container name —
#   postgresql://vedhanth:CHANGE_ME@vedhanth_db:5432/vedhanth?schema=public
DATABASE_URL="postgresql://vedhanth:CHANGE_ME@localhost:5432/vedhanth?schema=public"

# NextAuth — the public URL the site is served from, and a random secret.
# Generate the secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME"

# Only used by `npm run db:seed` to create/update the first admin login.
# Unset these again after seeding if you like.
ADMIN_EMAIL="admin@vedhanthitsolutions.in"
ADMIN_PASSWORD="CHANGE_ME_strong_password"
