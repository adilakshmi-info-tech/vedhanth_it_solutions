# Copy to .env and fill in. Both Next.js and Prisma read this file.
# When running via docker-compose.yml, this same file is also the source of
# the Postgres container's credentials (env_file: .env) — keep DATABASE_URL
# and POSTGRES_* in sync with each other.

# --- Postgres container (docker-compose.yml only) --------------------------
POSTGRES_DB="vedhanth"
POSTGRES_USER="vedhanth"
POSTGRES_PASSWORD="CHANGE_ME"

# --- App data (Postgres via Prisma) -----------------------------------------
# Bare-metal / PM2: DB runs on localhost.
# Docker Compose: the web container reaches Postgres by container name —
#   postgresql://vedhanth:CHANGE_ME@vedhanth_db:5432/vedhanth?schema=public
DATABASE_URL="postgresql://vedhanth:CHANGE_ME@localhost:5432/vedhanth?schema=public"

# --- Admin auth (Firebase Auth — shared sjs-technology project) ------------
# NEXT_PUBLIC_* values are safe to expose (Firebase web config is not a
# secret by design; access control happens via ADMIN_ALLOWED_EMAILS below).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDBkx4KX5G6mnRnYBKN_k0FGtkPRiGzZuU"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="sjs-technology.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sjs-technology"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="sjs-technology.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="30732567404"
NEXT_PUBLIC_FIREBASE_APP_ID="1:30732567404:web:dc30ebe332593766226949"

# Server-side allowlist — sjs-technology is a SHARED project across several
# apps, so any valid signed-in user of that project is NOT automatically a
# Vedhanth admin. Only emails listed here (comma-separated) can pass
# requireAdmin() / middleware.js. Add the Firebase user you created for this
# site here.
ADMIN_ALLOWED_EMAILS="admin@vedhanthitsolutions.com"

# --- Product image uploads (shared S3-backed API, see image-upload.md) -----
NEXT_PUBLIC_IMAGE_UPLOAD_BASE_URL="https://store.adilakshmi.co/api/v2"
NEXT_PUBLIC_IMAGE_UPLOAD_APP_SLUG="sjs-technology"
